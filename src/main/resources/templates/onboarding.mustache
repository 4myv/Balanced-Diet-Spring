{{>layout/header}}

<section>
    <p class="eyebrow">01ㆍ시작하기</p>
    <h1>당신의 몸을 알려주세요</h1>
    <p class="lede">키ㆍ몸무게ㆍ나이 같은 기초 정보를 입력하면, AI가 하루 권장 영양소를 계산하는 데 사용해요.</p>

    <form action="/onboarding" method="post">
        <div class="card">
            <div class="field-row">
                <label for="height">키 (cm)</label>
                <input type="number" id="height" name="height" step="0.1" placeholder="170" required>
            </div>
            <div class="field-row">
                <label for="weight">몸무게 (kg)</label>
                <input type="number" id="weight" name="weight" step="0.1" placeholder="65" required>
            </div>
            <div class="field-row">
                <label for="age">나이</label>
                <input type="number" id="age" name="age" placeholder="17" required>
            </div>
            <div class="field-row">
                <label for="gender">성별</label>
                <select id="gender" name="gender">
                    <option value="male">남성</option>
                    <option value="female">여성</option>
                </select>
            </div>
            <div class="field-row">
                <label for="activity">활동량</label>
                <select id="activity" name="activity">
                    <option value="low">낮음 · 주로 앉아서 생활</option>
                    <option value="mid" selected>보통 · 주 2~3회 운동</option>
                    <option value="high">높음 · 주 4회 이상 운동</option>
                </select>
            </div>
        </div>
        <button type="submit" class="btn-primary">다음ㆍ목표 설정하기</button>
    </form>
</section>
{{>layout/footer}}